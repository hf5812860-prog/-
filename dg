        if data.VehicleSpeed then Config.VehicleSpeed = data.VehicleSpeed; pcall(function() UI_Elements.VehicleSpeedSlider:Set(data.VehicleSpeed) end) end
        if data.AutoRepairVehicle ~= nil then Config.AutoRepairVehicle = data.AutoRepairVehicle; pcall(function() UI_Elements.AutoRepairToggle:Set(data.AutoRepairVehicle) end) end
        if data.HopNoFishEnabled ~= nil then Config.HopNoFishEnabled = data.HopNoFishEnabled == true end
        if data.HopNoFishMinutes then Config.HopNoFishMinutes = data.HopNoFishMinutes end
        if data.HopWatchFish then
