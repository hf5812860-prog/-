local cachedInventoryData = {rods = {}, baits = {}, fishCount = 0, inventoryCount = 0, lastUpdate = 0}

local function refreshInventoryCache()
    local now = tick()
    if now - cachedInventoryData.lastUpdate < 1.5 then return end
    cachedInventoryData.lastUpdate = now

    local items = PlayerGui:FindFirstChild("Items")
    local holding = items and items:FindFirstChild("ItemsHolder") and items.ItemsHolder:FindFirstChild("ItemsScrollingFrame")
    local rods, baits = {}, {}
    local fishCount, inventoryCount = 0, 0

    if holding then
        for _, v in pairs(holding:GetChildren()) do
            if v.Name ~= 'Folder' and v.Name ~= 'UIGridLayout' and v.Name ~= "ItemTemplate" then
                inventoryCount = inventoryCount + 1
                local nameLbl = v:FindFirstChild("ItemName")
                local itemType = v:GetAttribute("ItemType")
                local typeLower = itemType and string.lower(tostring(itemType)) or ""
                local nameText = (nameLbl and nameLbl.Text) or ""
                local nameLower = string.lower(nameText)

                if typeLower == "fish" then fishCount = fishCount + 1 end
                if string.find(nameLower, "rod") then
                    local equipped = v:FindFirstChild("ItemEquipped")
                    table.insert(rods, {name = nameText, uid = v.Name, equipped = equipped and equipped.Visible or false})
                end
                if string.find(nameLower, "wormtec") or string.find(nameLower, "prawntec") then
                    table.insert(baits, {name = nameText, uid = v.Name})
                end
            end
        end
    end
    cachedInventoryData.rods = rods
    cachedInventoryData.baits = baits
    cachedInventoryData.fishCount = fishCount
    cachedInventoryData.inventoryCount = inventoryCount
end

