        end
        if Config.ZoneSelect == "Level 70 +" then
            pcall(CreateHopWatch)
        else
            pcall(DestroyHopWatch)
        end
        if HopRemainLabel then
            HopRemainLabel.Visible = Config.HopNoFishEnabled == true
        end
        if data.SellAfterFishCount then Config.SellAfterFishCount = data.SellAfterFishCount; pcall(function() UI_Elements.SellAfterFishSlider:Set(data.SellAfterFishCount) end) end
        if data.Respawn ~= nil then Config.Respawn = data.Respawn; pcall(function() UI_Elements.RespawnToggle:Set(data.Respawn) end) end
        
        if data.ScaleValue then ApplyMenuScale(data.ScaleValue); pcall(function() UI_Elements.MenuScaleSlider:Set(math.floor(data.ScaleValue * 100)) end) end
        if data.ButtonScaleValue then ApplyButtonScale(data.ButtonScaleValue); pcall(function() UI_Elements.ButtonScaleSlider:Set(math.floor(data.ButtonScaleValue * 100)) end) end

        if data.SkipBadFishEnabled ~= nil then skipBadFishEnabled = data.SkipBadFishEnabled; pcall(function() UI_Elements.SkipBadFishToggle:Set(data.SkipBadFishEnabled) end) end
        if data.SkipDelay then skipDelay = data.SkipDelay; pcall(function() UI_Elements.SkipDelaySlider:Set(data.SkipDelay) end) end
        if data.SkipFishSelected then
            for k, v in pairs(data.SkipFishSelected) do
                if skipFishSelected[k] ~= nil then
                    skipFishSelected[k] = v
                    if UI_Elements.SkipFishToggles[k] then pcall(function() UI_Elements.SkipFishToggles[k]:Set(v) end) end
                end
            end
        end
        
        if data.AntiKick ~= nil then AntiKickEnabled = data.AntiKick; pcall(function() UI_Elements.AntiKickToggle:Set(data.AntiKick) end) end
        if data.ServerSwitch ~= nil then ServerSwitchEnabled = data.ServerSwitch; pcall(function() UI_Elements.ServerSwitchToggle:Set(data.ServerSwitch) end) end
        if data.ServerSwitchInterval then ServerSwitchInterval = data.ServerSwitchInterval; pcall(function() UI_Elements.ServerIntervalSlider:Set(data.ServerSwitchInterval) end) end

        if AntiKickEnabled then EnableAntiKick(true) else EnableAntiKick(false) end
        return true
    end)
