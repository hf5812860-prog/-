function Sf:IsAtAnchorPos()
    if not RootPart then return false end
    local zone = Config.ZoneSelect
    if zone ~= "Level 70 +" then return false end
    local data = Zones and Zones[zone]
    if not data or not data.AnchorPos then return false end
    local anchorPos = data.AnchorPos
    local myPos = RootPart.Position
    local dist = (Vector3.new(myPos.X, 0, myPos.Z) - Vector3.new(anchorPos.X, 0, anchorPos.Z)).Magnitude
    local yDiff = math.abs(myPos.Y - anchorPos.Y)
    return dist <= 8 and yDiff <= 15
end

