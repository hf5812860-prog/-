local function createSlider(parent, text, min, max, default, callback)
    local value = default or min
    local frame = new("Frame", { Size = UDim2.new(1, 0, 0, 54), BackgroundColor3 = THEME.Panel, BackgroundTransparency = 0.18, BorderSizePixel = 0, Parent = parent })
    new("UICorner", {CornerRadius = UDim.new(0, 12), Parent = frame})
    applyCardBg(frame)
    new("UIStroke", {Color = THEME.Stroke, Thickness = 1, Transparency = 0.2, Parent = frame})
    local label = new("TextLabel", { Size = UDim2.new(1, -24, 0, 22), Position = UDim2.fromOffset(14, 6), BackgroundTransparency = 1, Font = FONT_MEDIUM, Text = text .. ": " .. value, TextColor3 = THEME.Text, TextXAlignment = Enum.TextXAlignment.Left, TextSize = 13, Parent = frame })
    local track = new("Frame", { Name = "SliderTrack", Size = UDim2.new(1, -28, 0, 6), Position = UDim2.fromOffset(14, 36), BackgroundColor3 = Color3.fromRGB(215, 215, 220), BorderSizePixel = 0, Active = true, Parent = frame })
    new("UICorner", {CornerRadius = UDim.new(1, 0), Parent = track})
    local fill = new("Frame", { Name = "SliderFill", Size = UDim2.new((value - min) / math.max(max - min, 1), 0, 1, 0), BackgroundColor3 = THEME.Blue, BorderSizePixel = 0, Parent = track })
    new("UICorner", {CornerRadius = UDim.new(1, 0), Parent = fill})
    local knob = new("Frame", { Name = "SliderKnob", Size = UDim2.fromOffset(16, 16), Position = UDim2.new((value - min) / math.max(max - min, 1), -8, 0.5, 0), AnchorPoint = Vector2.new(0, 0.5), BackgroundColor3 = Color3.fromRGB(255, 255, 255), BorderSizePixel = 0, ZIndex = 5, Active = true, Parent = track })
    new("UICorner", {CornerRadius = UDim.new(1, 0), Parent = knob})
    new("UIStroke", {Color = THEME.Blue, Thickness = 2, Parent = knob})
    local dragging = false
    local function apply(v)
        value = math.clamp(math.floor(v + 0.5), min, max)
        local alpha = (value - min) / math.max(max - min, 1)
        fill.Size = UDim2.new(alpha, 0, 1, 0)
        knob.Position = UDim2.new(alpha, -8, 0.5, 0)
        label.Text = text .. ": " .. value
    end
    local function update(input)
        local alpha = math.clamp((input.Position.X - track.AbsolutePosition.X) / math.max(track.AbsoluteSize.X, 1), 0, 1)
        apply(min + (max - min) * alpha)
        if callback then callback(value) end
    end
    track.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then dragging = true; update(input) end
    end)
    knob.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then dragging = true end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then update(input) end
    end)
    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then dragging = false end
    end)
    return { Set = function(_, v) apply(v) end, Frame = frame }
end
