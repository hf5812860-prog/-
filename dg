function Sf:SmoothVerticalMove(targetY, duration, forceMove)
    duration = duration or 0.6
    if not RootPart or not Humanoid then return end

    local vehicle = Sf:GetOwnedVehicle()
    local useVehicle = Config.UseVehicle and vehicle and vehicle.PrimaryPart

    if useVehicle then
        if not Humanoid.Sit then Sf:EnterVehicle(vehicle) task.wait(0.1) end
        vehicle = Sf:GetOwnedVehicle()
        if not (vehicle and vehicle.PrimaryPart) then useVehicle = false end
    end

    local startCFrame = useVehicle and vehicle:GetPivot() or RootPart.CFrame
    local startY = startCFrame.Position.Y
    local startXZ = Vector3.new(startCFrame.Position.X, 0, startCFrame.Position.Z)
    local rotOnly = startCFrame - startCFrame.Position
    local startTime = tick()

    if useVehicle then Sf:CreateHiddenPlatform(vehicle) end

    local function ForceHold(cframe)
        if useVehicle and vehicle and vehicle.PrimaryPart then
            vehicle:PivotTo(cframe)
            Sf:FreezeVehicle(vehicle)
            Sf:UpdateHiddenPlatform(vehicle)
            if Humanoid then Humanoid.Sit = true end
            if RootPart then
                RootPart.AssemblyLinearVelocity = Vector3.zero
                RootPart.AssemblyAngularVelocity = Vector3.zero
            end
        elseif RootPart then
            RootPart.CFrame = cframe
            RootPart.AssemblyLinearVelocity = Vector3.zero
            RootPart.AssemblyAngularVelocity = Vector3.zero
        end
    end

    while (tick() - startTime) < duration and (forceMove or (Config.AutoFarmActive and not isProtectionTriggered)) do
        local alpha = math.clamp((tick() - startTime) / duration, 0, 1)
        alpha = alpha * alpha * (3 - 2 * alpha)
        local newY = startY + (targetY - startY) * alpha
        ForceHold(CFrame.new(Vector3.new(startXZ.X, newY, startXZ.Z)) * rotOnly)
        task.wait(0.012)
    end

    local finalCFrame = CFrame.new(Vector3.new(startXZ.X, targetY, startXZ.Z)) * rotOnly
    local lockEnd = tick() + 0.1
    while tick() < lockEnd and (forceMove or Config.AutoFarmActive) do
        ForceHold(finalCFrame)
        task.wait(0.012)
    end
    UpdateActivity()
end

function Sf:QuickAction(actionFn, durationUp)
    durationUp = durationUp or 0.3
    if not RootPart or not Humanoid then return end

    local vehicle = Sf:GetOwnedVehicle()
    local useVehicle = Config.UseVehicle and vehicle and vehicle.PrimaryPart

    if useVehicle then
        if not Humanoid.Sit then Sf:EnterVehicle(vehicle) task.wait(0.1) end
        vehicle = Sf:GetOwnedVehicle()
        if not (vehicle and vehicle.PrimaryPart) then useVehicle = false end
    end

    local targetY = 252 - INTERACT_DROP
    local startCFrame = useVehicle and vehicle:GetPivot() or RootPart.CFrame
    local startY = startCFrame.Position.Y
    local startXZ = Vector3.new(startCFrame.Position.X, 0, startCFrame.Position.Z)
    local rotOnly = startCFrame - startCFrame.Position
    local startTime = tick()

    if useVehicle then Sf:CreateHiddenPlatform(vehicle) end

    local function ForceHold(cframe)
        if useVehicle and vehicle and vehicle.PrimaryPart then
            vehicle:PivotTo(cframe)
            Sf:FreezeVehicle(vehicle)
            Sf:UpdateHiddenPlatform(vehicle)
            if Humanoid then Humanoid.Sit = true end
            if RootPart then
                RootPart.AssemblyLinearVelocity = Vector3.zero
                RootPart.AssemblyAngularVelocity = Vector3.zero
            end
        elseif RootPart then
            RootPart.CFrame = cframe
            RootPart.AssemblyLinearVelocity = Vector3.zero
            RootPart.AssemblyAngularVelocity = Vector3.zero
        end
    end

    while (tick() - startTime) < durationUp and Config.AutoFarmActive do
        local alpha = math.clamp((tick() - startTime) / durationUp, 0, 1)
        alpha = alpha * alpha * (3 - 2 * alpha)
        local newY = startY + (targetY - startY) * alpha
        ForceHold(CFrame.new(Vector3.new(startXZ.X, newY, startXZ.Z)) * rotOnly)
        task.wait(0.012)
    end

    local finalCFrame = CFrame.new(Vector3.new(startXZ.X, targetY, startXZ.Z)) * rotOnly
    local holdEnd = tick() + 0.08
    while tick() < holdEnd and Config.AutoFarmActive do
        ForceHold(finalCFrame)
        task.wait(0.012)
    end

    if actionFn then pcall(actionFn) end

    local waitEnd = tick() + 0.08
    while tick() < waitEnd and Config.AutoFarmActive do
        ForceHold(finalCFrame)
        task.wait(0.012)
    end
    UpdateActivity()
end

function Sf:Drive(vehicle, destination, continueCheck)
    if not vehicle or not vehicle.PrimaryPart then return end
    Config.StopWalking = false
    Config.Running = true

    if typeof(destination) == "CFrame" then
        destination = destination.Position
    end

    local targetY = destination.Y
    if math.abs(targetY - UNDERGROUND_Y) < 15 then
        targetY = UNDERGROUND_Y
    end
    local goalPos = Vector3.new(destination.X, targetY, destination.Z)

    Sf:CreateHiddenPlatform(vehicle)

    if Humanoid and not Humanoid.Sit then
        Sf:EnterVehicle(vehicle)
        task.wait(0.1)
    end

    local speed = Config.VehicleSpeed or 55
    local arriveDist = 5
    local maxTime = 45
    local startTime = tick()
    local lastTick = tick()

    local rayDist = 26
    local sideCheckDist = 18
    local turnSpeed = math.rad(170)
    local lockedTurnDir = nil
    local stuckTimer = 0
    local lastPos = vehicle.PrimaryPart.Position
    local stuckThreshold = 1.2

    local function freezeVeh(veh)
        if not veh then return end
        for _, part in ipairs(veh:GetDescendants()) do
            if part:IsA("BasePart") then
                part.AssemblyLinearVelocity = Vector3.zero
                part.AssemblyAngularVelocity = Vector3.zero
            end
        end
    end

    local function rayFilter()
        local params = RaycastParams.new()
        params.FilterType = Enum.RaycastFilterType.Exclude
        local filter = {Character}
        if vehicle then table.insert(filter, vehicle) end
        if HiddenPlatform then table.insert(filter, HiddenPlatform) end
        params.FilterDescendantsInstances = filter
        params.IgnoreWater = true
        return params
    end

    local function isClear(fromPos, dir, dist)
        local origin = Vector3.new(fromPos.X, targetY + 2, fromPos.Z)
        local hit = workspace:Raycast(origin, dir * dist, rayFilter())
        return hit == nil
    end

    local function getForwardDir(cf, goal)
        local pos = Vector3.new(cf.Position.X, targetY, cf.Position.Z)
        local toGoal = Vector3.new(goal.X - pos.X, 0, goal.Z - pos.Z)
        if toGoal.Magnitude < 0.15 then
            local v = Vector3.new(cf.LookVector.X, 0, cf.LookVector.Z)
            return v.Magnitude > 0.05 and v.Unit or Vector3.new(0, 0, -1)
        end
        return toGoal.Unit
    end

    local function moveForward(dt, currentSpeed)
        local cf = vehicle:GetPivot()
        local pos = Vector3.new(cf.Position.X, targetY, cf.Position.Z)
        local forwardDir = getForwardDir(cf, goalPos)
        local newPos = pos + forwardDir * currentSpeed * dt
        vehicle:PivotTo(CFrame.new(newPos, newPos + forwardDir))
    end

    local function turnVehicle(direction, dt)
        local cf = vehicle:GetPivot()
        local pos = Vector3.new(cf.Position.X, targetY, cf.Position.Z)
        local look = Vector3.new(cf.LookVector.X, 0, cf.LookVector.Z)
        if look.Magnitude < 0.05 then
            look = Vector3.new(0, 0, -1)
        end
        look = look.Unit

        local currentYaw = math.atan2(look.X, look.Z)
        local newYaw
        if direction == "right" then
            newYaw = currentYaw - turnSpeed * dt
        else
            newYaw = currentYaw + turnSpeed * dt
        end
        vehicle:PivotTo(CFrame.new(pos) * CFrame.Angles(0, newYaw, 0))
    end

    while Config.AutoFarmActive and not Config.StopWalking and not isProtectionTriggered do
        task.wait()

        if isDeadGlobal and isDeadGlobal() then
            Config.Running = false
            return
        end
        if not vehicle or not vehicle.PrimaryPart then
            Config.Running = false
            return
        end
        if continueCheck and not continueCheck() then
            break
        end
        if tick() - startTime > maxTime then
            break
        end

        if Humanoid and not Humanoid.Sit then
            Sf:EnterVehicle(vehicle)
        end

        local cf = vehicle:GetPivot()
        local now = Vector3.new(cf.Position.X, targetY, cf.Position.Z)
        local toGoal = Vector3.new(goalPos.X - now.X, 0, goalPos.Z - now.Z)

        if toGoal.Magnitude <= arriveDist then
            break
        end

        local nowTick = tick()
        local dt = math.clamp(nowTick - lastTick, 0, 0.05)
        lastTick = nowTick

        local moved = (now - Vector3.new(lastPos.X, targetY, lastPos.Z)).Magnitude
        if moved < 0.35 then
            stuckTimer = stuckTimer + dt
        else
            stuckTimer = 0
            lastPos = now
        end

        local forwardDir = getForwardDir(cf, goalPos)
        local wallAhead = not isClear(now, forwardDir, rayDist)

        if stuckTimer > stuckThreshold then
            lockedTurnDir = (lockedTurnDir == "left") and "right" or "left"
            stuckTimer = 0
            turnVehicle(lockedTurnDir, dt)
            Sf:UpdateHiddenPlatform(vehicle)
            freezeVeh(vehicle)
            continue
        end

        if lockedTurnDir then
            if wallAhead then
                turnVehicle(lockedTurnDir, dt)
            else
                lockedTurnDir = nil
                moveForward(dt, speed)
            end
        else
            if wallAhead then
                local rightDir = Vector3.new(-forwardDir.Z, 0, forwardDir.X)
                local leftDir  = Vector3.new(forwardDir.Z, 0, -forwardDir.X)

                local rightClear = isClear(now, rightDir, sideCheckDist)
                local leftClear  = isClear(now, leftDir, sideCheckDist)

                local rightScore = 99999
                local leftScore  = 99999

                if rightClear then
                    rightScore = (now + rightDir * 12 - goalPos).Magnitude
                end
                if leftClear then
                    leftScore = (now + leftDir * 12 - goalPos).Magnitude
                end

                if rightScore < leftScore then
                    lockedTurnDir = "right"
                elseif leftScore < rightScore then
                    lockedTurnDir = "left"
                else
                    local rightDot = rightDir:Dot((toGoal.Magnitude > 0.1) and toGoal.Unit or forwardDir)
                    local leftDot  = leftDir:Dot((toGoal.Magnitude > 0.1) and toGoal.Unit or forwardDir)
                    lockedTurnDir = (rightDot >= leftDot) and "right" or "left"
                end

                turnVehicle(lockedTurnDir, dt)
            else
                moveForward(dt, speed)
            end
        end

        local pivot = vehicle:GetPivot()
        if math.abs(pivot.Position.Y - targetY) > 0.8 then
            vehicle:PivotTo(CFrame.new(pivot.Position.X, targetY, pivot.Position.Z) * (pivot - pivot.Position))
        end

        Sf:UpdateHiddenPlatform(vehicle)
        freezeVeh(vehicle)
    end

    Config.Running = false
    UpdateActivity()
end

function Sf:WalkTo(destination, continueCheck)
    if isProtectionTriggered then return end
    Config.StopWalking = false; Config.Running = true

    local path = PathfindingService:CreatePath({
        AgentCanJump = true, AgentJumpHeight = 2.5, AgentHeight = 8, AgentRadius = 2.5, AgentMaxSlope = 90,
        Costs = {BlockedNode = 50, DoorArea = 1}
    })

    local success = pcall(function() path:ComputeAsync(RootPart.Position, destination) end)
    if not success or path.Status ~= Enum.PathStatus.Success then
        Config.Running = false; return
    end

    local waypoints = path:GetWaypoints()
    local speed = Config.WalkSpeed or 20

    for _, wp in pairs(waypoints) do
        if isProtectionTriggered or not Config.AutoFarmActive or Config.StopWalking then
            Config.Running = false; return
        end
        if continueCheck and not continueCheck() then
            Config.Running = false; return
        end

        local offsetY = (wp.Action == Enum.PathWaypointAction.Jump) and 10 or 4
        local targetPos = wp.Position + Vector3.new(0, offsetY, 0)
        local startPos = RootPart.Position
        local dir = (targetPos - startPos).Unit
        local dist = (targetPos - startPos).Magnitude
        local movedDist = 0
        local startTime = tick()

        while movedDist < dist and Config.AutoFarmActive and not Config.StopWalking and not isProtectionTriggered do
            task.wait()
            if Humanoid.Health <= 0 then break end
            if continueCheck and not continueCheck() then break end

            local elapsed = tick() - startTime
            movedDist = math.min(elapsed * speed, dist)
            local newPos = startPos + dir * movedDist
            if Humanoid.Sit then Humanoid.Sit = false end
            RootPart:PivotTo(CFrame.new(newPos))
            pcall(function() Net.send("set_sprinting_1", true) end)
        end
    end
    Config.Running = false
    UpdateActivity()
end

function Sf:WalkToSurface(destination, value)
