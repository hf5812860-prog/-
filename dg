                    has = true
                end
            end)
        end
    end)
    if has then return true end

    pcall(function()
        local Items = PlayerGui:FindFirstChild("Items")
        local Holding = Items and Items:FindFirstChild("ItemsHolder") and Items.ItemsHolder:FindFirstChild("ItemsScrollingFrame")
        if not Holding then return end
        for _, v in pairs(Holding:GetChildren()) do
            if v.Name ~= "Folder" and v.Name ~= "UIGridLayout" and v.Name ~= "ItemTemplate" then
                local itemType = v:GetAttribute("ItemType")
                if itemType and string.lower(tostring(itemType)) == "fish" then
                    has = true
                    break
                end
            end
        end
    end)
    return has
end

local farmLoopRunning = false

function StartAutoFarm()
    if farmLoopRunning then return end
    farmLoopRunning = true
    CaughtSinceLastSell = 0
    castActive = false
    castStartTime = 0
    isReeling = false
    lastReelTime = 0

    task.spawn(function()
        while Config.AutoFarmActive do
            pcall(function()
                local char = Client.Character or Client.CharacterAdded:Wait()
                local humanoid = char:FindFirstChildOfClass("Humanoid")
                local tool = GetRodTool()
                if tool and humanoid and tool.Parent == Client.Backpack then
                    humanoid:EquipTool(tool)
                end
            end)
            task.wait(1)
        end
    end)

    if Config.UseVehicle then
        local currentVehicle = Sf:GetOwnedVehicle()
        local hp, maxHP, uid, vname, destroyed, itemRef = Sf:GetVehicleHealth(nil)

        if not hp then
            local dataV = Sf:GetVehicleDataFromData(nil)
            if dataV then
                hp = dataV.health
                maxHP = dataV.maxHealth
                uid = dataV.guid
                vname = dataV.name
                destroyed = dataV.destroyed
                itemRef = dataV.rawItem
            end
        end

        if destroyed == true or (type(hp) == "number" and hp <= 0) then
            if currentVehicle then
                if Humanoid and Humanoid.Sit then
                    pcall(function() Net.get("exit_seat") end)
                    task.wait(0.3)
                end
            end

            Sf:TryAutoRepair()
            if not Config.AutoFarmActive then farmLoopRunning = false return end

            task.wait(0.5)
            local hpAfter = select(1, Sf:GetVehicleHealth(nil))
            if not hpAfter or hpAfter <= 0 then
                local newVeh = Sf:RespawnAndMountVehicle()
                if not newVeh then
                    pcall(function() Net.send("request_respawn") end)
                    task.wait(0.5)
                    pcall(function() Net.send("death_screen_request_respawn") end)
                    task.wait(1)
                    newVeh = Sf:RespawnAndMountVehicle()
                end
                if not newVeh then
                    ShowToast("NEE", "ما قدرت أجيب سيارة — تأكد من الفلوس")
                    Config.AutoFarmActive = false
                    pcall(function() UI_Elements.AutoFarmToggle:Set(false) end)
                    farmLoopRunning = false
                    return
                end
            end
        end

        if hp and type(hp) == "number" and hp > 0 and hp < GetRepairThreshold() and not destroyed then
            Sf:TryAutoRepair()
            if not Config.AutoFarmActive then farmLoopRunning = false return end
        end
    end

    if Config.UseVehicle then
        if Humanoid and Humanoid.Sit then
            pcall(function() Net.get("exit_seat") end)
            task.wait(0.08)
        end

        local vehicle = Sf:GetOwnedVehicle()
        if not vehicle or not vehicle.PrimaryPart then
            vehicle = Sf:RespawnAndMountVehicle()
        end

        if not vehicle or not vehicle.PrimaryPart then
            pcall(function() Net.send("request_respawn") end)
            task.wait(0.3)
            pcall(function() Net.send("death_screen_request_respawn") end)
            task.wait(0.5)
            local wc = 0
            while wc < 15 do
                task.wait(0.2)
                local c = Client.Character
                if c and c:FindFirstChild("Humanoid") and c:FindFirstChild("HumanoidRootPart") then
                    local h = c:FindFirstChildOfClass("Humanoid")
                    if h and h.Health > 0 then break end
                end
                wc = wc + 1
            end
            Character = Client.Character
            Humanoid = Character and Character:FindFirstChildOfClass("Humanoid")
            RootPart = Character and Character:FindFirstChild("HumanoidRootPart")
            vehicle = Sf:RespawnAndMountVehicle()
        end

        if not vehicle or not vehicle.PrimaryPart then
            ShowToast("NEE", "تم إيقاف الفارم")
            Config.AutoFarmActive = false
            pcall(function() UI_Elements.AutoFarmToggle:Set(false) end)
            farmLoopRunning = false
            return
        end

        if Humanoid and not Humanoid.Sit then
            Sf:EnterVehicle(vehicle)
        end
        pcall(function() Net.send("lock_vehicle", vehicle, true) end)

        if not Humanoid or not Humanoid.Sit then
            ShowToast("NEE", "تم إيقاف الفارم")
            Config.AutoFarmActive = false
            pcall(function() UI_Elements.AutoFarmToggle:Set(false) end)
            farmLoopRunning = false
            return
        end
    end

    EquipRod()
    if not Config.AutoFarmActive then farmLoopRunning = false return end

    if Config.UseVehicle then
        local vehicle = Sf:GetOwnedVehicle()
        if vehicle then Sf:CreateHiddenPlatform(vehicle) end
    end

    if Humanoid and Humanoid.Sit and Sf:GetOwnedVehicle() then
        Sf:SmoothVerticalMove(UNDERGROUND_Y, 0.35)
    end

    if Config.AutoBuyEnabled then
        local hasRodStart = select(1, Sf:HasAnyRod())
        local hasBaitStart = select(1, Sf:HasAnyBait())
        if not (hasRodStart and hasBaitStart) then
            BuyEquipment()
            if not Config.AutoFarmActive then farmLoopRunning = false return end
        end
    end

    while Config.AutoFarmActive do
        if not Client.Character or not Client.Character.Parent then task.wait(0.5) continue end

        Character = Client.Character
        Humanoid = Character:FindFirstChildOfClass("Humanoid")
        RootPart = Character:FindFirstChild("HumanoidRootPart")

        if isProtectionTriggered then
            while isProtectionTriggered and Config.AutoFarmActive do task.wait(0.2) end
            if not Config.AutoFarmActive then break end
            continue
        end

        if isDeadGlobal() then
            task.wait(0.5)
            continue
        end

        if isSkippingFish or isReeling then
            task.wait(0.1)
            continue
        end

        EnsureRodEquipped()

        local zone = Config.ZoneSelect
        local data = Zones[zone]
        if not data then task.wait(0.5); continue end

        local fishCount = fishStats.totalFish
        local isFull, inventoryCount, maxSlots = Sf:IsInventoryFull()
        local hasBait = Sf:HasAnyBait()
        local hasFish = playerHasFish()

        local needSell = false
        if ForceSellNext then needSell = true; ForceSellNext = false end

        if not needSell then
            if hasFish then
                if Config.SellAfterFishCount > 0 and CaughtSinceLastSell >= Config.SellAfterFishCount then
                    needSell = true
                elseif isFull then needSell = true
                elseif (not hasBait) then needSell = true end
            end
        end

        if needSell then
            if playerHasFish() then
                if CaughtSinceLastSell > 0 or fishCount > 0 or ForceSellNext then
                    task.wait(0.15)
                    Sf:SellFishWithPath()
                    task.wait(0.2)
                end
                CaughtSinceLastSell = 0

                if Sf:GetMoney() > 0 then
                    local hasBaitNow = Sf:HasAnyBait()
                    if not hasBaitNow then
                        DepositAllMoney()
                        task.wait(0.15)
                    end
                end
            else
                CaughtSinceLastSell = 0
            end

            if not Config.AutoFarmActive then break end
            hasBait = Sf:HasAnyBait()
            if not hasBait then
                if Config.AutoBuyEnabled then
                    BuyEquipment()
                    if not Config.AutoFarmActive then break end
                    EquipRod()
                    task.wait(0.15)
                end
            end
            isFull, inventoryCount, maxSlots = Sf:IsInventoryFull()
            hasBait = Sf:HasAnyBait()
        end

        if Config.AutoFarmActive and Config.AutoBuyEnabled then
            local hasRodNow = select(1, Sf:HasAnyRod())
            hasBait = Sf:HasAnyBait()
            if (not hasBait) or (not hasRodNow) then
                BuyEquipment()
                if not Config.AutoFarmActive then break end
                EquipRod()
                EquipBaitOnRod()
                task.wait(0.15)
                hasBait = Sf:HasAnyBait()
                isFull, inventoryCount, maxSlots = Sf:IsInventoryFull()
            end
        end

        if Config.AutoFarmActive and (not isFull) and hasBait then
            if Config.AutoRepairVehicle then
                local hpCheck, maxHpCheck, uidCheck, nameCheck, destroyedCheck, itemRefCheck = Sf:GetVehicleHealth(nil)
                local thresholdCheck = GetRepairThreshold()

                if destroyedCheck == true or (hpCheck and type(hpCheck) == "number" and hpCheck < thresholdCheck) then
                    if tick() - lastMidFarmRepairTick > 8 then
                        lastMidFarmRepairTick = tick()

                        local oldAutoFarm = Config.AutoFarmActive

                        if destroyedCheck == true then
                            if Humanoid and Humanoid.Sit then
                                Sf:ExitVehicle()
                                task.wait(0.2)
                            end
                        end

                        Sf:TryAutoRepair()

                        if oldAutoFarm then
                            local reVehicle = Sf:GetOwnedVehicle()
                            if not reVehicle or not reVehicle.PrimaryPart then
                                Sf:ForceRespawnVehicle()
                            else
                                if Humanoid and not Humanoid.Sit then
                                    Sf:EnterVehicle(reVehicle)
                                    task.wait(0.2)
                                end
                                pcall(function() Net.send("lock_vehicle", reVehicle, true) end)
                            end

                            if Humanoid and Humanoid.Sit then
                                Sf:SmoothVerticalMove(UNDERGROUND_Y, 0.3)
                            end
                        end
                        task.wait(0.2)
                    end
                end
            end

            local zonePos = data.Pos
            local myPos = RootPart and RootPart.Position or zonePos
            local distToZone = (Vector3.new(myPos.X, 0, myPos.Z) - Vector3.new(zonePos.X, 0, zonePos.Z)).Magnitude

            if distToZone > 55 then
                Sf:SmartMoveTo(data.Pos)
                task.wait(0.05)
            end

            if Config.UseVehicle then
                local vehicle = Sf:GetOwnedVehicle()
                if vehicle and Humanoid and not Humanoid.Sit then Sf:EnterVehicle(vehicle) task.wait(0.05) end
                local veh = Sf:GetOwnedVehicle()
                local holdPart = (veh and veh.PrimaryPart) or RootPart
                if holdPart and math.abs(holdPart.Position.Y - UNDERGROUND_Y) > 2 then
                    Sf:SmoothVerticalMove(UNDERGROUND_Y, 0.3)
                end
            end

            if isProtectionTriggered then continue end
            if isSkippingFish or isReeling then continue end
            if not Sf:HasAnyBait() then continue end
            EnsureRodEquipped()
            EquipBaitOnRod()

            local castPos
            if data.CastPositions and #data.CastPositions > 0 then
                castPos = data.CastPositions[CurrentCastIndex] or data.CastPositions[1]
            else
                castPos = FIXED_CAST_POS
            end

            local rodTool = GetRodTool()
            if rodTool and Humanoid and rodTool.Parent == Backpack then
                pcall(function() Humanoid:EquipTool(rodTool) end)
                rodTool = GetRodTool()
            end

            local finalFull, finalCnt, finalMax = Sf:IsInventoryFull()
            if finalFull or (finalCnt and finalMax and finalCnt >= finalMax) then
                castActive = false
            elseif isSkippingFish or isReeling then
                castActive = true
            elseif isSliderOpen() then
                castActive = true
            elseif not castActive and (tick() - (lastReelTime or 0)) >= 1.0 then
                castActive = true
                castStartTime = tick()
                ForceNextCast = false
                if rodTool and castPos then
                    if rodTool.Parent == Backpack then
                        pcall(function() Humanoid:EquipTool(rodTool) end)
                        rodTool = GetRodTool()
                    end
                    pcall(function() Net.get("throw_rod", rodTool, castPos) end)
                    lastThrowTick = tick()
                end
            elseif castActive and (tick() - castStartTime) > CAST_TIMEOUT then
                castStartTime = tick()
                pcall(function()
                    EnsureRodEquipped()
                    local rt = GetRodTool()
                    if rt and castPos then Net.get("throw_rod", rt, castPos) end
                end)
                lastThrowTick = tick()
            end

            UpdateActivity()

            local timeout = tick() + 12
            local progressBarVisible = false
            while Config.AutoFarmActive and tick() < timeout and not isProtectionTriggered do
                if isDeadGlobal() then break end
                local fullNow = select(1, Sf:IsInventoryFull())
                if fullNow then
                    ForceSellNext = true
                    break
                end
                if isSliderOpen() then
                    progressBarVisible = true
                    castActive = true
                    UpdateActivity()
                    break
                end
                task.wait(0.03)
            end

            if isProtectionTriggered then continue end
            if isDeadGlobal() then continue end

            local keptThisCatch = false
            if progressBarVisible then
                local sliderSeenAt = tick()
                while Config.AutoFarmActive and isSliderOpen() and not isProtectionTriggered do
                    if isDeadGlobal() then break end
                    local hooked = getHookedFishName()
                    local elapsed = tick() - sliderSeenAt

                    if isSkipTarget(hooked) then
                        if elapsed >= skipDelay and not isSkippingFish then
                            doSkipHookedFish(hooked, true)
                            ForceSellNext = false
                            keptThisCatch = false
                            break
                        end
                        task.wait(0.02)
                    else
                        isReeling = true
                        PlaySliderMinigame()
                        if rodTool then
                            pcall(function() Net.send("reel_ended", rodTool, true) end)
                        end
                        lastReelTime = tick()
                        castActive = false
                        castStartTime = 0
                        task.wait(0.5)
                        isReeling = false
                        CaughtSinceLastSell = CaughtSinceLastSell + 1
                        keptThisCatch = true

                        BumpCastToggle()

                        if hooked then
                            updateFishStats(hooked)
                        else
                            lastWatchedCatchTime = tick()
                            getgenv().NEE_HopWatchTick = lastWatchedCatchTime
                        end

                        if skipBadFishEnabled and (not hooked or not isSkipTarget(hooked)) then
                            ForceSellNext = true
                        end
                        break
                    end
                end
                UpdateActivity()
            else
                local hooked = getHookedFishName()
                if isSkipTarget(hooked) and not isSkippingFish then
                    doSkipHookedFish(hooked, false)
                    ForceSellNext = false
                    keptThisCatch = false
                elseif rodTool then
                    isReeling = true
                    pcall(function() Net.send("reel_ended", rodTool, false) end)
                    lastReelTime = tick()
                    castActive = false
                    castStartTime = 0
                    isReeling = false
                    BumpCastToggle()
                    if hooked then
                        updateFishStats(hooked)
                    end
                    if skipBadFishEnabled and hooked and not isSkipTarget(hooked) then
                        ForceSellNext = true
                    end
                end
            end

            if keptThisCatch and Config.AutoFarmActive and ForceSellNext then
                local waitFish = tick()
                while tick() - waitFish < 1.4 and not playerHasFish() and Config.AutoFarmActive do
                    task.wait(0.1)
                end
                if playerHasFish() then
                    Sf:SellFishWithPath()
                    task.wait(0.15)
                    CaughtSinceLastSell = 0
                end
                ForceSellNext = false
                ForceNextCast = false
                castActive = false
                castStartTime = 0
                if Config.AutoFarmActive and Zones[Config.ZoneSelect] then
                    Sf:SmartMoveTo(Zones[Config.ZoneSelect].Pos)
                    Sf:SmoothVerticalMove(UNDERGROUND_Y, 0.3)
                end
            elseif keptThisCatch and Config.AutoFarmActive and not ForceSellNext then
                local fullNow = select(1, Sf:IsInventoryFull())
                local shouldSellNow = fullNow or (Config.SellAfterFishCount > 0 and CaughtSinceLastSell >= Config.SellAfterFishCount)

                if shouldSellNow and CaughtSinceLastSell > 0 and playerHasFish() then
                    task.wait(0.15)
                    Sf:SellFishWithPath()
                    task.wait(0.2)
                    CaughtSinceLastSell = 0
                    if Config.AutoFarmActive and Zones[Config.ZoneSelect] then
                        Sf:SmartMoveTo(Zones[Config.ZoneSelect].Pos)
                        Sf:SmoothVerticalMove(UNDERGROUND_Y, 0.3)
                    end
                else
                    task.wait(1)
                    ForceNextCast = true
                end
            end
        end
        task.wait(0.1)
    end
    farmLoopRunning = false
end

local lastBuyTime = 0
local BUY_COOLDOWN = 5

function BuyEquipment()
    if tick() - lastBuyTime < BUY_COOLDOWN then return false end
    lastBuyTime = tick()

    local Items = PlayerGui:FindFirstChild("Items")
    local Holding = Items and Items:FindFirstChild("ItemsHolder") and Items.ItemsHolder:FindFirstChild("ItemsScrollingFrame")
    if Holding then
        for _, v in pairs(Holding:GetChildren()) do
            if v.Name ~= 'Folder' and v.Name ~= 'UIGridLayout' and v.Name ~= "ItemTemplate" then
                local nameLbl = v:FindFirstChild("ItemName")
                local itemType = v:GetAttribute("ItemType")
                local nameText = (nameLbl and nameLbl.Text) and string.lower(nameLbl.Text) or ""
                local typeLower = itemType and string.lower(tostring(itemType)) or ""
                local isFish = (typeLower == "fish")
                local isRod = string.find(nameText, "rod") ~= nil
                local isBait = string.find(nameText, "wormtec") ~= nil or string.find(nameText, "prawntec") ~= nil
                local isVehicle = (typeLower == "car" or typeLower == "bike")
                if not isFish and not isRod and not isBait and not isVehicle then
                    pcall(function() Net.get("drop_item", v.Name, 1) end)
                    task.wait(0.04)
                end
            end
        end
    end

    local selectedRod = Config.RodSelect
    local selectedBait = Config.BaitSelect
    local targetBait = Config.BaitAmount
    local fishingLevel = Sf:GetSkill("Fishing")
    local targetRod = selectedRod

    if targetRod == "Smart Select" then
        for _, rod in ipairs(FishingRods) do if fishingLevel >= rod.Level then targetRod = rod.Name; break end end
    end

    local targetBaitName = selectedBait
    if targetBaitName == "Smart Select" then
        for _, bait in ipairs(FishingBaits) do if fishingLevel >= bait.Level then targetBaitName = bait.Name; break end end
    end

    cachedInventoryData.lastUpdate = 0
    refreshInventoryCache()

    local hasRodAfterDrop = select(1, Sf:HasAnyRod()) or (GetRodTool() ~= nil) or (GetRodInHand() ~= nil)
    local hasBaitAfterDrop = select(1, Sf:HasAnyBait())
    local totalCost = 0

    if not hasRodAfterDrop then
        for _, rod in ipairs(FishingRods) do if rod.Name == targetRod then totalCost = totalCost + rod.Price; break end end
    end
    if not hasBaitAfterDrop then
        for _, bait in ipairs(FishingBaits) do if bait.Name == targetBaitName then totalCost = totalCost + (bait.Price * targetBait); break end end
    end

    if totalCost <= 0 then return true end

    if Sf:GetMoney() < totalCost then
        pcall(function() Sf:WithdrawFromBank(totalCost) end)
        task.wait(0.35)
    end
    local handNow = Sf:GetMoney() or 0
    local bankNow = Sf:GetBankMoney() or 0
    if not hasRodAfterDrop and (handNow + bankNow) < totalCost then
        Config.AutoFarmActive = false
        Config.StopWalking = true
        Config.Running = false
        pcall(function() if UI_Elements.AutoFarmToggle then UI_Elements.AutoFarmToggle:Set(false) end end)
        ShowStickyMoney("NEE", "ماعندك فلوس كافيه لشراء سناره")
        return false
    end

    Sf:SmartMoveTo(ShopLocation)
    task.wait(0.2)

    local shopFolder = workspace:FindFirstChild("ShopZone_Hardware")
    if not shopFolder then return false end

    Sf:QuickAction(function()
        if not hasRodAfterDrop then
            pcall(function() Net.get("purchase_consumable", shopFolder, targetRod) end)
            task.wait(0.3)
        end
        if not hasBaitAfterDrop then
            for i = 1, targetBait do
                if not Config.AutoFarmActive then break end
                pcall(function() Net.get("purchase_consumable", shopFolder, targetBaitName) end)
                task.wait(0.05)
            end
        end
    end, 0.4)

    task.wait(0.15)
    cachedInventoryData.lastUpdate = 0
    refreshInventoryCache()
    
    Sf:SmoothVerticalMove(UNDERGROUND_Y, 0.3)
    UpdateActivity()
    return true
end

task.spawn(function()
    while task.wait(60) do
        pcall(SaveConfig)
    end
end)

pcall(function() if AntiKickEnabled then EnableAntiKick(true) end end)
