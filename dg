local cachedOwnedVehicle = nil
local lastVehicleCache = 0

function Sf:GetOwnedVehicle()
    local now = tick()
    if now - lastVehicleCache < 0.2 and cachedOwnedVehicle and cachedOwnedVehicle.Parent then
        return cachedOwnedVehicle
    end
    lastVehicleCache = now
    cachedOwnedVehicle = nil
    local vehiclesFolder = workspace:FindFirstChild("Vehicles") or workspace
    local best, bestDist = nil, math.huge
    local myPos = RootPart and RootPart.Position
    local function consider(vehicle)
        if not vehicle or not vehicle:IsA("Model") then return end
        local pp = vehicle.PrimaryPart or vehicle:FindFirstChildWhichIsA("BasePart")
        if not pp then return end
        local owner = vehicle:GetAttribute("OwnerUserId") or vehicle:GetAttribute("Owner") or vehicle:GetAttribute("UserId")
        local mine = owner == UserId or owner == tostring(UserId) or owner == Client.Name
        if not mine then
            for _, d in ipairs(vehicle:GetDescendants()) do
                if d:IsA("VehicleSeat") and d.Occupant == Humanoid then mine = true break end
            end
        end
        if not mine and myPos then
            local dist = (pp.Position - myPos).Magnitude
            if dist <= 28 then mine = true end
        end
        if mine then
            local dist = myPos and (pp.Position - myPos).Magnitude or 0
            if dist < bestDist then
                best, bestDist = vehicle, dist
            end
        end
    end
    if vehiclesFolder then
        for _, vehicle in ipairs(vehiclesFolder:GetChildren()) do
            consider(vehicle)
        end
    end
    if not best then
        for _, m in ipairs(workspace:GetChildren()) do
            if m:IsA("Model") and m:FindFirstChildWhichIsA("VehicleSeat", true) then
                consider(m)
            end
        end
    end
    cachedOwnedVehicle = best
    return best
end
