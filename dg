            end
            if left <= 0 and Config.AutoFarmActive then
                local anySelected = false
                for _, on in pairs(Config.HopWatchFish or {}) do
                    if on == true then anySelected = true break end
                end
                if anySelected then
                    lastWatchedCatchTime = tick()
                    getgenv().NEE_HopWatchTick = tick()
                    task.spawn(SwitchToSmallestServer)
                end
            end
        end)
    end
