function Sf:PullVehicle(vehicle)
    if not vehicle or not vehicle.PrimaryPart then return false end
    if not RootPart then return false end

    local charLook = RootPart.CFrame.LookVector
    local spawnHeight = (Config.VehicleType == "Bike") and 3 or 7
    local targetCF = CFrame.new(
        RootPart.Position + Vector3.new(0, spawnHeight, 0)
    ) * CFrame.Angles(0, math.atan2(charLook.X, charLook.Z), 0)

    pcall(function()
        vehicle:PivotTo(targetCF)
        for _, part in ipairs(vehicle:GetDescendants()) do
            if part:IsA("BasePart") then
                part.AssemblyLinearVelocity = Vector3.zero
                part.AssemblyAngularVelocity = Vector3.zero
            end
        end
    end)
    return true
end

function Sf:EnterVehicle(vehicle)
    if isWaitingRespawn() then return false end
    if not vehicle then return false end
    if not vehicle.PrimaryPart then
        vehicle.PrimaryPart = vehicle:FindFirstChildWhichIsA("BasePart")
    end
    if Humanoid and Humanoid.Sit then return true end

    local skipPull = false
    if RootPart then
        local y = RootPart.Position.Y
        if y < 150 or y > 400 then skipPull = true end
        if math.abs(y - (UNDERGROUND_Y or 230)) < 8 then skipPull = true end
    end

    if not skipPull then
        Sf:PullVehicle(vehicle)
        task.wait(0.2)
    end

    pcall(function() Net.send("lock_vehicle", vehicle, true) end)
    pcall(function() Net.get("lock_vehicle", vehicle, true) end)
    pcall(function() Net.get("set_vehicle_locked", vehicle, true) end)

    for attempt = 1, 5 do
        pcall(function()
            for _, prompt in pairs(vehicle.PrimaryPart:GetDescendants()) do
                if prompt:IsA("ProximityPrompt") then
                    fireproximityprompt(prompt)
                end
            end
        end)
        if Humanoid and Humanoid.Sit then
            task.wait(0.4)
            pcall(function() Net.send("lock_vehicle", vehicle, true) end)
            return true
        end
        task.wait(0.25)
    end

    local timeout = tick() + 5
    while Humanoid and not Humanoid.Sit and tick() < timeout do
        task.wait(0.1)
    end

    if Humanoid.Sit then
        pcall(function() Net.send("lock_vehicle", vehicle, true) end)
        pcall(function() Net.get("lock_vehicle", vehicle, true) end)
        pcall(function() Net.get("set_vehicle_locked", vehicle, true) end)
    end

    return Humanoid.Sit
end

