local function GetAllVehicleNames(vehicleType)
    local vehicles = {"Smart Select"}
    local seen = {}
    local wantType = (vehicleType == "Car") and "car" or "bike"
    local Items = PlayerGui:FindFirstChild("Items")
    local Holding = Items and Items:FindFirstChild("ItemsHolder") and Items.ItemsHolder:FindFirstChild("ItemsScrollingFrame")
    if Holding then
        for _, v in ipairs(Holding:GetChildren()) do
            local itemType = v:GetAttribute("ItemType")
            local nameLbl = v:FindFirstChild("ItemName")
            if nameLbl and nameLbl.Text and nameLbl.Text ~= "" and itemType == wantType and not seen[nameLbl.Text] then
                seen[nameLbl.Text] = true
                table.insert(vehicles, nameLbl.Text)
            end
        end
    end
    table.sort(vehicles, function(a, b)
        if a == "Smart Select" then return true end
        if b == "Smart Select" then return false end
        return a < b
    end)
    return vehicles
end

