function Sf:RespawnAndMountVehicle()
    local existing = Sf:GetOwnedVehicle()
    if existing and existing.PrimaryPart then
        if Humanoid and Humanoid.Sit then
            pcall(function() Net.send("lock_vehicle", existing, true) end)
            return existing
        end
        Sf:EnterVehicle(existing)
        local sitTriesFast = 0
        while Humanoid and not Humanoid.Sit and sitTriesFast < 6 and Config.AutoFarmActive do
            Sf:EnterVehicle(existing); task.wait(0.08); sitTriesFast = sitTriesFast + 1
        end
        if Humanoid and Humanoid.Sit then return existing end
    end

    if Humanoid and Humanoid.Sit then Sf:ExitVehicle() task.wait(0.12) end

    local vehicleName, vehicleUid, equipped = Sf:GetVehicleUidFromInventory()
    if not vehicleName then
        local spawned = Sf:EnsureVehicle()
        if spawned then Sf:EnterVehicle(spawned) task.wait(0.1) return spawned end
        return nil
    end

    local pullTries = 0
    while (Sf:GetOwnedVehicle() or equipped) and pullTries < 8 and Config.AutoFarmActive do
        pcall(function() Net.get("toggle_equip_item", tostring(vehicleUid)) end)
        task.wait(0.15)
        _, vehicleUid, equipped = Sf:GetVehicleUidFromInventory()
        if not Sf:GetOwnedVehicle() and not equipped then break end
        pullTries = pullTries + 1
    end
    task.wait(0.08)
    pcall(function() Net.get("toggle_equip_item", tostring(vehicleUid)) end)

    local vehicle = nil
    local tries = 0
    while tries < 20 and Config.AutoFarmActive do
        vehicle = Sf:GetOwnedVehicle()
        if vehicle and vehicle.PrimaryPart then break end
        task.wait(0.08); tries = tries + 1
    end

    if not vehicle then return nil end
    task.wait(0.06)
    Sf:EnterVehicle(vehicle)
    pcall(function() Net.send("lock_vehicle", vehicle, true) end)

    local sitTries = 0
    while Humanoid and not Humanoid.Sit and sitTries < 12 and Config.AutoFarmActive do
        Sf:EnterVehicle(vehicle); task.wait(0.08); sitTries = sitTries + 1
    end
    return vehicle
end

