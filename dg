function Sf:IsATMAvailable(atm)
    if not atm or not atm.Parent then return false end
    local ok, available = pcall(function()
        if not atm:FindFirstChild("Area") then return false end
        local keys = {}
        for k in pairs(atm:GetAttributes()) do table.insert(keys, k) end
        table.sort(keys)
        if keys[3] and atm:GetAttribute(keys[3]) == true then return false end
        return true
    end)
    return ok and available == true
end

function Sf:FindClosestAvailableATM(excludeAtm)
    local success, result = pcall(function()
        local atmFolder = workspace:FindFirstChild("Map") and workspace.Map:FindFirstChild("Props") and workspace.Map.Props:FindFirstChild("ATMs")
        if not atmFolder then return nil end
        local closestAvail, shortestAvail = nil, math.huge
        for _, atm in pairs(atmFolder:GetChildren()) do
            if atm ~= excludeAtm and atm.Name == "ATM" and atm:IsA("Model") and atm:FindFirstChild("Area") then
                if Sf:IsATMAvailable(atm) then
                    local d = Sf:dist(atm.Area.Position)
                    if d < shortestAvail then
                        closestAvail = atm
                        shortestAvail = d
                    end
                end
            end
        end
        return closestAvail
    end)
    return success and result or nil
end

function DepositAllMoney()
    local success = pcall(function()
        local handMoney = Sf:GetMoney()
        if handMoney <= 0 then return true end

        local overallStart = tick()
        local maxOverall = 40
        local tried = {}

        while Config.AutoFarmActive and (tick() - overallStart) < maxOverall do
            local handNow = Sf:GetMoney()
            if handNow <= 0 then return true end

            local atm = Sf:FindClosestAvailableATM()
            local skipTries = 0
            while atm and tried[atm] and skipTries < 5 do
                atm = Sf:FindClosestAvailableATM(atm)
                skipTries = skipTries + 1
            end
            if not atm or not atm:FindFirstChild("Area") then return false end

            local targetPos = atm.Area.Position
            local startTime = tick()
            local moveDone = false
            local aborted = false

            Config.StopWalking = false
            task.spawn(function()
                Sf:SmartMoveTo(targetPos, function()
                    if not Config.AutoFarmActive then return false end
                    if not Sf:IsATMAvailable(atm) then aborted = true; return false end
                    return true
                end)
                moveDone = true
            end)

            while not moveDone and (tick() - startTime) < 15 and Config.AutoFarmActive do
                task.wait(0.2)
                if not Sf:IsATMAvailable(atm) then
                    aborted = true
                    Config.StopWalking = true
                    task.wait(0.1)
                    Config.StopWalking = false
                    break
                end
            end

            if aborted or not Sf:IsATMAvailable(atm) then
                tried[atm] = true
                Config.StopWalking = true
                task.wait(0.1)
                Config.StopWalking = false
                continue
            end

            if (tick() - startTime) >= 15 and not moveDone then
                Config.StopWalking = true
                task.wait(0.15)
                Config.StopWalking = false
                tried[atm] = true
                continue
            end

            if not Sf:IsATMAvailable(atm) then tried[atm] = true continue end

            local stillHave = Sf:GetMoney()
            if stillHave > 0 then
                Sf:QuickAction(function()
                    if Sf:IsATMAvailable(atm) then
                        pcall(function() Net.get("transfer_funds", "hand", "bank", stillHave) end)
                    end
                end, 0.3)
                task.wait(0.15)
            end

            if Sf:GetMoney() <= 0 then
                if Humanoid and Humanoid.Sit and Sf:GetOwnedVehicle() then
                    Sf:SmoothVerticalMove(UNDERGROUND_Y, 0.3)
                end
                return true
            end
            tried[atm] = true
        end
        return Sf:GetMoney() <= 0
    end)
    return success
end

function Sf:WithdrawFromBank(amount, forceWalk)
    if amount <= 0 then return true end
    if Sf:GetMoney() >= amount then return true end
    local bank = Sf:GetBankMoney() or 0
    if bank <= 0 then return false end
    local need = math.min(amount - (Sf:GetMoney() or 0), bank)
    if need <= 0 then return true end

    local tried = {}
    local t0 = tick()
    while Config.AutoFarmActive and (tick() - t0) < 45 do
        if (Sf:GetMoney() or 0) >= amount then return true end
        local atm = Sf:FindClosestAvailableATM()
        local skips = 0
        while atm and tried[atm] and skips < 6 do
            atm = Sf:FindClosestAvailableATM(atm)
            skips = skips + 1
        end
        if not atm then return (Sf:GetMoney() or 0) >= amount end
        local atmPos = (atm.Area and atm.Area.Position) or (atm.PrimaryPart and atm.PrimaryPart.Position)
        if not atmPos then tried[atm] = true continue end

        if forceWalk then
            if Humanoid then Humanoid.WalkSpeed = 32 end
            if Humanoid and Humanoid.Sit then Sf:ExitVehicle(); task.wait(0.1) end
            if Humanoid then Humanoid.WalkSpeed = 32 end
        end

        local aborted = false
        Sf:SmartMoveTo(atmPos, function()
            if not Config.AutoFarmActive then return false end
            if not Sf:IsATMAvailable(atm) then aborted = true return false end
            return true
        end)
        if aborted or not Sf:IsATMAvailable(atm) then
            tried[atm] = true
            continue
        end

        local needNow = math.min(amount - (Sf:GetMoney() or 0), Sf:GetBankMoney() or 0)
        if needNow > 0 then
            Sf:QuickAction(function()
                if Sf:IsATMAvailable(atm) then
                    pcall(function() Net.get("transfer_funds", "bank", "hand", needNow) end)
                end
            end, 0.35)
            task.wait(0.2)
        end
        if (Sf:GetMoney() or 0) >= amount then
            return true
        end
        tried[atm] = true
    end
    return (Sf:GetMoney() or 0) >= amount
end

function Sf:TryAutoRepair()
    if not Config.AutoRepairVehicle then return true end

    local vehicleName = nil
    pcall(function() vehicleName = Sf:GetVehicleNameFromInventory() end)

    local currentHP, maxHP, vehicleUID, foundName, destroyed, itemRef = Sf:GetVehicleHealth(vehicleName)
    if currentHP == nil then
        currentHP, maxHP, vehicleUID, foundName, destroyed, itemRef = Sf:GetVehicleHealth(nil)
    end
    if currentHP and maxHP and currentHP > maxHP then
        currentHP, maxHP = maxHP, currentHP
    end

    local threshold = GetRepairThreshold()

    if currentHP == nil then return true end
    if currentHP >= threshold and not destroyed then return true end
    if not vehicleUID then return false end

    local repairCost = Sf:GetRepairCost(currentHP, maxHP or 1500, foundName or vehicleName, itemRef)
    if not repairCost or repairCost <= 0 then repairCost = 1000 end
    repairCost = math.floor(tonumber(repairCost) or 1000)

    local hand = math.floor(Sf:GetMoney() or 0)
    local bank = math.floor(Sf:GetBankMoney() or 0)

    local exploded = destroyed == true
    if hand < repairCost then
        if exploded and Humanoid then Humanoid.WalkSpeed = 32 end
        local needExact = math.max(0, repairCost - hand)
        Sf:WithdrawFromBank(needExact + hand, exploded)
        hand = math.floor(Sf:GetMoney() or 0)
    end

    if hand < repairCost then
        return false
    end

    if not getgenv()._NEE_LastRepairAt then getgenv()._NEE_LastRepairAt = 0 end
    if tick() - getgenv()._NEE_LastRepairAt < 6 then
    else
        getgenv()._NEE_LastRepairAt = tick()
        pcall(function() Net.get("repair_vehicle", vehicleUID) end)
        task.wait(1.2)
    end

    if exploded then
        pcall(function() Net.send("request_respawn") end)
        pcall(function() Net.send("death_screen_request_respawn") end)
        local w = 0
        while w < 20 do
            task.wait(0.25)
            local c = Client.Character
            local h = c and c:FindFirstChildOfClass("Humanoid")
            local rp = c and c:FindFirstChild("HumanoidRootPart")
            if h and rp and h.Health > 0 then
                Character, Humanoid, RootPart = c, h, rp
                break
            end
            w = w + 1
        end
        while Config.AutoFarmActive do
            local ns = Client:GetAttribute("SpawnVehicleNext")
            local n2 = workspace:GetServerTimeNow()
            if not ns or (ns - n2) <= 0 then break end
            task.wait(0.35)
        end
        Sf:ForceRespawnVehicle()
        local veh = Sf:GetOwnedVehicle()
        if veh and Humanoid and not Humanoid.Sit then
            Sf:EnterVehicle(veh)
        end
        if Humanoid and Humanoid.Sit then
            Sf:SmoothVerticalMove(UNDERGROUND_Y, 0.35)
        end
    end

    local newHP, _, _, _, newDestroyed = Sf:GetVehicleHealth(foundName or vehicleName)
    if newHP and newHP > 0 and not newDestroyed then
        return true
    else
        return false
    end
end

function Sf:ForceRespawnVehicle()
    if Humanoid and Humanoid.Sit then
        pcall(function() Net.get("exit_seat") end)
        task.wait(0.12)
    end

    local existing = Sf:GetOwnedVehicle()
    if existing and existing.PrimaryPart then
        Sf:EnterVehicle(existing)
        pcall(function() Net.send("lock_vehicle", existing, true) end)
        local sitTries = 0
        while Humanoid and not Humanoid.Sit and sitTries < 6 and Config.AutoFarmActive do
            Sf:EnterVehicle(existing); task.wait(0.08); sitTries = sitTries + 1
        end
        if Humanoid and Humanoid.Sit then
            return true
        end
    end

    local vehicle = Sf:RespawnAndMountVehicle()
    if vehicle and vehicle.PrimaryPart and Humanoid and Humanoid.Sit then
        pcall(function() Net.send("lock_vehicle", vehicle, true) end)
        return true
    end

    Config.Respawn = true
    pcall(function() if UI_Elements.RespawnToggle then UI_Elements.RespawnToggle:Set(true) end end)

    pcall(function() Net.send("request_respawn") end)
    task.wait(0.4)
    pcall(function() Net.send("death_screen_request_respawn") end)
    task.wait(0.4)

    local waitCount = 0
    local playerReady = false
    while waitCount < 25 do
        task.wait(0.4)
        local char = Client.Character
        if char and char.Parent and char:FindFirstChild("Humanoid") and char:FindFirstChild("HumanoidRootPart") then
            local h = char:FindFirstChildOfClass("Humanoid")
            if h and h.Health > 0 and h:GetState() ~= Enum.HumanoidStateType.Dead then
                playerReady = true
                break
            end
        end
        waitCount = waitCount + 1
    end

    task.wait(0.8)

    Character = Client.Character
    if Character then
        Humanoid = Character:FindFirstChildOfClass("Humanoid") or Humanoid
        RootPart = Character:FindFirstChild("HumanoidRootPart") or RootPart
        Backpack = Client:FindFirstChild("Backpack") or Backpack
    end

    for attempt = 1, 4 do
        if not Config.AutoFarmActive then return false end

        local existing2 = Sf:GetOwnedVehicle()
        if existing2 and existing2.PrimaryPart then
            Sf:EnterVehicle(existing2)
            pcall(function() Net.send("lock_vehicle", existing2, true) end)
            local sitTries = 0
            while Humanoid and not Humanoid.Sit and sitTries < 8 and Config.AutoFarmActive do
                Sf:EnterVehicle(existing2); task.wait(0.08); sitTries = sitTries + 1
            end
            if Humanoid and Humanoid.Sit then
                return true
            end
        end

        local vehicle2 = Sf:RespawnAndMountVehicle()
        if vehicle2 and vehicle2.PrimaryPart and Humanoid and Humanoid.Sit then
            pcall(function() Net.send("lock_vehicle", vehicle2, true) end)
            return true
        end

        task.wait(1.2)
    end

    return false
end

local ROD_TOOL_NAMES = {
    "FishingRodUltimate", "FishingRodAdvanced", "FishingRodPro", "FishingRodRegular",
    "Advanced Fishing rod", "Advanced Fishing Rod", "Ultimate Fishing rod", "Pro Fishing rod", "Regular Fishing rod"
}

local function isRodTool(tool)
    if not tool or not tool:IsA("Tool") then return false end
    local n = string.lower(tostring(tool.Name))
    if string.find(n, "rod") or string.find(n, "سنار") then return true end
    for _, name in ipairs(ROD_TOOL_NAMES) do
        if tool.Name == name then return true end
    end
    return false
end

function GetRodTool()
    local char = Client.Character
    local backpack = Client:FindFirstChild("Backpack")
    if char then
        local equipped = char:FindFirstChildOfClass("Tool")
        if equipped and isRodTool(equipped) then return equipped end
        for _, name in ipairs(ROD_TOOL_NAMES) do
            local t = char:FindFirstChild(name)
            if t and t:IsA("Tool") then return t end
        end
        for _, child in ipairs(char:GetChildren()) do
            if isRodTool(child) then return child end
        end
    end
    if backpack then
        for _, name in ipairs(ROD_TOOL_NAMES) do
            local t = backpack:FindFirstChild(name)
            if t and t:IsA("Tool") then return t end
        end
        for _, child in ipairs(backpack:GetChildren()) do
            if isRodTool(child) then return child end
        end
    end
    return nil
end

function EquipRod()
    local char = Client.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid") or Humanoid
    local pack = Client:FindFirstChild("Backpack") or Backpack

    for _, name in ipairs(ROD_TOOL_NAMES) do
        local t = (char and char:FindFirstChild(name)) or (pack and pack:FindFirstChild(name))
        if t then
            if hum and t.Parent == pack then pcall(function() hum:EquipTool(t) end) end
            return true
        end
    end
    if char then
        for _, t in ipairs(char:GetChildren()) do
            if isRodTool(t) then return true end
        end
    end
    if pack then
        for _, t in ipairs(pack:GetChildren()) do
            if isRodTool(t) then
                if hum then pcall(function() hum:EquipTool(t) end) end
                return true
            end
        end
    end

    cachedInventoryData.lastUpdate = 0
    local hasRod, rodName, rodUid = Sf:HasAnyRod()
    if hasRod and rodUid then
        pcall(function() Net.get("toggle_equip_item", tostring(rodUid)) end)
        task.wait(0.12)
        local tool = GetRodTool()
        if tool and hum and tool.Parent ~= char then
            pcall(function() hum:EquipTool(tool) end)
        end
        return GetRodTool() ~= nil
    end
    return false
end

