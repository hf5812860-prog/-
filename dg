function Sf:GetVehicleDataFromData(vehicleName)
    local wantType = (Config.VehicleType == "Car") and "car" or "bike"
    local found = nil
    if not ItemUtils or not Data_upvr then return nil end

    pcall(function()
        ItemUtils.iterate_through_items(Data_upvr, function(item, itemType)
            if not item or not item.name then return end
            local t = itemType
            if not t and ItemUtils.get_item_type then
                t = ItemUtils.get_item_type(item.name)
            end
            if t ~= wantType then return end

            if vehicleName and vehicleName ~= "" and vehicleName ~= "Smart Select" then
                if item.name ~= vehicleName then return end
            end

            if not found then
                local inst = ItemUtils.get_item_instance(item.name)
                local maxHP = 1500
                if inst and inst:GetAttribute("Health") then
                    maxHP = inst:GetAttribute("Health")
                end
                found = {
                    name = item.name,
                    guid = item.guid,
                    health = item.health or item.durability,
                    maxHealth = maxHP,
                    destroyed = (item.destroyed == true),
                    rawItem = item,
                }
            end
        end)
    end)

    return found
end

function Sf:GetVehicleHealth(vehicleName)
    local dataVehicle = Sf:GetVehicleDataFromData(vehicleName)
    if dataVehicle then
        return dataVehicle.health, dataVehicle.maxHealth, dataVehicle.guid, dataVehicle.name, dataVehicle.destroyed, dataVehicle.rawItem
    end

    local bestHP, bestMax = nil, 1000
    local bestUID, bestName = nil, nil
    pcall(function()
        local ScrollingFrame = PlayerGui.Items.ItemsHolder.ItemsScrollingFrame
        for _, v in ipairs(ScrollingFrame:GetChildren()) do
            local t = v:GetAttribute("ItemType")
            if t == "car" or t == "bike" then
                local nameLbl = v:FindFirstChild("ItemName")
                local nameText = nameLbl and nameLbl.Text or ""
                local match = true
                if vehicleName and vehicleName ~= "" and vehicleName ~= "Smart Select" then
                    match = (nameText == vehicleName) or (string.find(string.lower(nameText), string.lower(vehicleName), 1, true) ~= nil)
                end
                if match then
                    local healthLabel = v:FindFirstChild("ItemHealth")
                    if healthLabel and healthLabel.Text then
                        local current, max = healthLabel.Text:match("(%d+)%s*/%s*(%d+)")
                        if current then
                            bestHP = tonumber(current)
                            bestMax = tonumber(max)
                            bestUID = v.Name
                            bestName = nameText
                            if vehicleName and nameText == vehicleName then return end
                        end
                    end
                end
            end
        end
    end)

    return bestHP, bestMax, bestUID, bestName, (bestHP == 0), nil
end

function Sf:GetRepairCost(currentHP, maxHP, itemName, itemRef)
    currentHP = tonumber(currentHP) or 0
    maxHP = tonumber(maxHP) or 1000

    if Recovery and Recovery.get_repair_price_for_vehicle and itemName then
        local ok, costResult = pcall(function()
            return Recovery.get_repair_price_for_vehicle(itemName, currentHP, itemRef)
        end)
        if ok and type(costResult) == "number" and costResult > 0 then
            return math.floor(costResult)
        end
    end

    local diff = math.max(0, maxHP - currentHP)
    local estimate = math.floor(diff * 2.5)
    if estimate < 1 then estimate = 1000 end
    return estimate
end

