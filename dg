local function QueueScriptOnHop()
    local QueueFunction = queue_on_teleport or (syn and syn.queue_on_teleport) or queueonteleport
    if not QueueFunction then
        warn("[NEE] ❌ queue_on_teleport غير متوفر")
        return false
    end
    local src = getgenv().NEEFishFarmFullScript
    if not src or #src < 100 then
        warn("[NEE] ❌ السورس غير موجود")
        return false
    end
    local ok = pcall(function()
        local escaped = src:gsub("]", "]=]")
        local fullCode = "getgenv().NEEFishFarmFullScript = [==[" .. escaped .. "]==]\n" ..
                         "task.wait(1.5)\n" ..
                         "pcall(function() loadstring(getgenv().NEEFishFarmFullScript)() end)"
        QueueFunction(fullCode)
        print("✅ [NEE] تم حفظ السكربت في queue — الحجم: " .. #fullCode)
        return true
    end)
    return ok
end

getgenv().NEE_QueueScriptOnHop = QueueScriptOnHop

