function Sf:dist(pos)
    if typeof(pos) == "Vector3" then return (pos - RootPart.Position).Magnitude
    elseif typeof(pos) == "CFrame" then return (pos.Position - RootPart.Position).Magnitude
    elseif typeof(pos) == "Instance" and pos:IsA("BasePart") then return (pos.Position - RootPart.Position).Magnitude end
    return 9999
end

