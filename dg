        end
        if data.VehicleSelect then
            Config.VehicleSelect = data.VehicleSelect
            if data.VehicleSelect ~= "Smart Select" then
                UserPickedVehicle = data.VehicleSelect
                UserPickedAt = tick()
            end
        end

        task.spawn(function()
            task.wait(0.2)
            pcall(function() UI_Elements.VehicleTypeDropdown:Set(Config.VehicleType) end)
            UpdateVehicleSelectUI()
            task.wait(0.5)
