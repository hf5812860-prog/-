local function UpdateProfitTracker()
    pcall(function()
        if not ProfitTracker.Initialized then return end
        local currentHand = HandMoney() or 0
        local currentBank = ATMMoney() or 0
        local handDiff = currentHand - ProfitTracker.LastHand
        local bankDiff = currentBank - ProfitTracker.LastBank
        if handDiff < 0 and bankDiff > 0 and math.abs(math.abs(handDiff) - bankDiff) < 5 then
        elseif bankDiff < 0 and handDiff > 0 and math.abs(math.abs(bankDiff) - handDiff) < 5 then
        elseif handDiff > 0 and bankDiff == 0 then
            ProfitTracker.Net = ProfitTracker.Net + handDiff
        elseif handDiff < 0 and bankDiff == 0 then
            ProfitTracker.Net = ProfitTracker.Net + handDiff
        elseif handDiff ~= 0 or bankDiff ~= 0 then
            ProfitTracker.Net = ProfitTracker.Net + (handDiff + bankDiff)
        end
        ProfitTracker.LastHand = currentHand
        ProfitTracker.LastBank = currentBank
    end)
end

